@echo off
setlocal EnableExtensions DisableDelayedExpansion
chcp 65001 >nul
cd /d "%~dp0"
set "CB_STUDIO_DIAG_ROOT=%~dp0"
echo Cyberboard Studio startup diagnostics
echo Close any existing Studio window before running this check.
echo No USB access, network request, or system configuration change.
echo If Studio opens, close it before reading the saved report.
echo.
rem Fixed inline PowerShell only: no downloaded script or execution-policy override.
rem Quoted command fragments are joined by powershell.exe -Command.
powershell.exe -NoLogo -NoProfile -NonInteractive -Command ^
 "$ErrorActionPreference='Stop'; $root=$env:CB_STUDIO_DIAG_ROOT; $leaf='Cyberboard-Studio-startup-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'-'+[Guid]::NewGuid().ToString('N'); $report=Join-Path $env:TEMP $leaf; $null=New-Item -ItemType Directory -Path $report; $summary=Join-Path $report 'summary.txt'; $utf8=[Text.UTF8Encoding]::new($false); function Note([string]$text) { [IO.File]::AppendAllText($summary,$text+[Environment]::NewLine,$utf8); Write-Host $text }; $failed=$false;" ^
 "function Launch([string]$label,[string[]]$arguments) { $trace=Join-Path $report ($label+'-host-trace.log'); $out=Join-Path $report ($label+'-stdout.txt'); $err=Join-Path $report ($label+'-stderr.txt'); $env:DOTNET_HOST_TRACE='1'; $env:DOTNET_HOST_TRACEFILE=$trace; $env:DOTNET_HOST_TRACE_VERBOSITY='4'; $env:COREHOST_TRACE='1'; $env:COREHOST_TRACEFILE=$trace; $env:COREHOST_TRACE_VERBOSITY='4'; $options=@{FilePath=$exe; WorkingDirectory=$root; RedirectStandardOutput=$out; RedirectStandardError=$err; PassThru=$true; ErrorAction='Stop'}; if ($arguments.Count -gt 0) { $options.ArgumentList=$arguments }; Note ('Attempt: '+$label); $launchStatus='launch-error'; try { $process=Start-Process @options; $null=$process.Handle; if ($process.WaitForExit(15000)) { $process.WaitForExit(); $process.Refresh(); $rawCode=$process.ExitCode; if ($null -eq $rawCode) { $launchStatus='unknown-exit'; Note 'Process exited, but its exit code could not be obtained. The probe has not been verified.' } else { $code=[int]$rawCode; $hex='0x'+[BitConverter]::ToUInt32([BitConverter]::GetBytes($code),0).ToString('X8'); Note ('Exit code: '+$code+' ('+$hex+')'); if ($code -eq 0) { $launchStatus='exited-success' } else { $launchStatus='exited-failure' }; if ($label -eq 'probe') { if ($code -eq 0) { Note 'Managed runtime probe exited normally; GUI/WebView2/USB are not verified.' } else { Note 'Managed runtime probe failed; see probe-stdout.txt and probe-stderr.txt.' } } else { Note 'Normal app exited; exit code alone does not prove successful UI startup.' } } } else { $launchStatus='running'; Note 'Still running after 15 seconds. Startup result is undetermined; a system dialog may be open.'; Note 'The process has been left running. If the workbench is visible, close Studio before reading the report.' } } catch { Note ('Launch exception type: '+$_.Exception.GetType().FullName); Note ('Exception HResult: 0x'+$_.Exception.HResult.ToString('X8')); $errorObject=$_.Exception; while ($null -ne $errorObject) { if ($errorObject -is [ComponentModel.Win32Exception]) { Note ('Win32 error: '+$errorObject.NativeErrorCode) }; $errorObject=$errorObject.InnerException } }; Note ('Saved: '+$label+'-stdout.txt, '+$label+'-stderr.txt, '+$label+'-host-trace.log (if the host could start).'); return $launchStatus };" ^
 "try { Note 'Cyberboard Studio startup report'; Note ('Collected: '+(Get-Date -Format 'yyyy-MM-dd HH:mm:ss K')); Note 'Only fixed OS/package fields and this run startup output are collected.'; $os=Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion'; foreach ($field in @('ProductName','DisplayVersion','CurrentBuildNumber','UBR','EditionID')) { Note ('Windows '+$field+': '+$os.$field) }; Note ('64-bit operating system: '+[Environment]::Is64BitOperatingSystem); $architecture=$env:PROCESSOR_ARCHITEW6432; if ([string]::IsNullOrWhiteSpace($architecture)) { $architecture=$env:PROCESSOR_ARCHITECTURE }; Note ('System architecture: '+$architecture); foreach ($name in @('Cyberboard Studio.exe','Cyberboard Studio.dll','coreclr.dll','hostfxr.dll','hostpolicy.dll','WebView2Loader.dll','Cyberboard Studio.runtimeconfig.json')) { $path=Join-Path $root $name; if (Test-Path -LiteralPath $path -PathType Leaf) { $hash=Get-FileHash -LiteralPath $path -Algorithm SHA256; Note ('SHA256 '+$name+': '+$hash.Hash) } else { Note ('Missing package file: '+$name) } }; $exe=Join-Path $root 'Cyberboard Studio.exe'; if (-not (Test-Path -LiteralPath $exe -PathType Leaf)) { throw [IO.FileNotFoundException]::new() }; $probe=$false; $manifest=Join-Path $root 'release-manifest.json'; if (Test-Path -LiteralPath $manifest -PathType Leaf) { try { $metadata=Get-Content -LiteralPath $manifest -Raw -Encoding UTF8 | ConvertFrom-Json; Note ('Package version: '+$metadata.version); $probe=($metadata.diagnosticStartup -is [bool]) -and $metadata.diagnosticStartup } catch { Note 'Package manifest is unreadable; using legacy normal-startup check.' } }; if ($probe) { $probeStatus=Launch 'probe' @('--diagnostic-startup'); if ($probeStatus -eq 'exited-success') { $null=Launch 'app' @() } else { Note 'Normal app startup skipped: the managed runtime probe did not confirm exit code 0. Read the probe trace and output first.' } } else { Note 'Legacy package: managed runtime probe not advertised; no diagnostic argument will be passed.'; $null=Launch 'app' @() } } catch { $failed=$true; Note ('Collection exception type: '+$_.Exception.GetType().FullName); Note ('Exception HResult: 0x'+$_.Exception.HResult.ToString('X8')) };" ^
 "Note 'No existing host.log, settings, credentials, workspace, or event log was collected.'; Note 'Host tracing may contain local installation paths. Review files before sharing.'; Note 'Diagnostic collection is complete; it does not certify Windows compatibility.'; Write-Host ''; Write-Host ('Report directory: '+[char]37+'TEMP'+[char]37+'\'+$leaf); Write-Host 'Open that folder in File Explorer and keep summary.txt plus the trace/stdout/stderr files.'; if ($failed) { exit 1 }; exit 0"
if errorlevel 1 echo Diagnostics could not complete. Review the report above, if one was created.
echo.
pause
endlocal
